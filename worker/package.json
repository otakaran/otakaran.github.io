{
  "name": "oja-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OJA Solutions booking + contact backend (Cloudflare Worker + D1 + Resend).",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply oja-booking --local",
    "db:migrate:remote": "wrangler d1 migrations apply oja-booking --remote"
  },
  "devDependencies": {
    "vitest": "^2.1.8",
    "wrangler": "^4.152.0"
  }
}
